from SCons.Script import SConscript

Import("project", "board", "toolchain", "os", "services")


initramfs = project.initramfs(
    name="initramfs",
    generator=os.kernel.gen_init_cpio,
    base="initramfs.base",
    sysroots=[toolchain],
)

images = SConscript(
    str(board.image_sconscript),
    exports={
        "project": project,
        "os": os,
        "initramfs": initramfs,
    },
)

Return("images")
