CT_CONFIG_VERSION="4"
CT_ARCH_ARM=y
CT_ARCH_CPU="cortex-a7"
CT_ARCH_FPU="neon-vfpv4"
CT_ARCH_FLOAT_HW=y
CT_ARCH_ARM_MODE_ARM=y
CT_TARGET_VENDOR="ipc"
CT_KERNEL_LINUX=y
CT_LINUX_V_7_2=y
CT_LIBC_GLIBC=y
CT_GLIBC_V_2_44=y
CT_CC_GCC=y
CT_GCC_V_16_2_0=y
CT_CC_LANG_CXX=y
CT_PREFIX_DIR="@PREFIX@"
CT_LOCAL_TARBALLS_DIR="@DOWNLOADS@"
CT_SAVE_TARBALLS=y
# CT_LOG_PROGRESS_BAR is not set
