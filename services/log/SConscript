from types import SimpleNamespace

Import("project", "toolchain", "shared")


api = project.interface_library(
    name="log-api",
    headers=["include/log/log.hpp"],
    include_directories=["include"],
    dependencies=[shared],
)

server = project.executable(
    name="log",
    sources=["source/log.cpp"],
    compile_options=["-O2", "-pipe", "-Wall", "-Wextra"],
    link_options=["-pthread"],
    dependencies=[api],
    toolchain=toolchain,
    initramfs="/services/log",
)

log = SimpleNamespace(api=api, server=server)

Return("log")
