from types import SimpleNamespace

Import("project", "toolchain", "shared")


api = project.interface_library(
    name="gpio-api",
    headers=["include/gpio/gpio.hpp"],
    include_directories=["include"],
    dependencies=[shared],
)

server = project.executable(
    name="gpio",
    sources=["source/gpio.cpp"],
    compile_options=["-std=c++26", "-O2", "-pipe", "-Wall", "-Wextra"],
    link_options=["-pthread"],
    dependencies=[api],
    toolchain=toolchain,
    initramfs="/services/gpio",
)

gpio = SimpleNamespace(api=api, server=server)

Return("gpio")
