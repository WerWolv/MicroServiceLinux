from types import SimpleNamespace

from SCons.Script import SConscript

Import("project", "toolchain", "lib")


fs = SConscript(
    "fs/SConscript",
    exports={
        "project": project,
        "toolchain": toolchain,
        "shared": lib.shared,
    },
)

log = SConscript(
    "log/SConscript",
    exports={
        "project": project,
        "toolchain": toolchain,
        "shared": lib.shared,
    },
)

gpio = SConscript(
    "gpio/SConscript",
    exports={
        "project": project,
        "toolchain": toolchain,
        "shared": lib.shared,
    },
)

spi = SConscript(
    "spi/SConscript",
    exports={
        "project": project,
        "toolchain": toolchain,
        "shared": lib.shared,
    },
)

display = SConscript(
    "display/SConscript",
    exports={
        "project": project,
        "toolchain": toolchain,
        "shared": lib.shared,
        "logging": log.api,
        "gpio": gpio.api,
        "spi": spi.api,
    },
)

services = SimpleNamespace(fs=fs, log=log, gpio=gpio, spi=spi, display=display)

Return("services")
